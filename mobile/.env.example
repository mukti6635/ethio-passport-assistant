# ETHIO — environment configuration template.
# Copy to `.env` (git-ignored) and fill with real values on your machine.
# NEVER commit a filled `.env` to source control.

# --- Supabase (from dashboard → Project Settings → API) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-side ONLY (never in the app, never in git) ---
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# AI_API_KEY=your-ai-provider-key
# BROWSER_WEBUI_URL=http://localhost:7788
# BROWSER_API_KEY=your-browser-webui-key

# ETHIO gateway — environment template (placeholders ONLY).
#
# The gateway reads these from its process environment (there is no
# .env loader). For the pilot, keep real values in ~/ethio-pilot.env
# (chmod 600, OUTSIDE this repository) and source it — see
# docs/PILOT_RUNBOOK.md. NEVER commit real values.
#
# (This file replaces the upstream browser-use template that shipped
# with the base project; that template documented a different product.
# It is preserved in git history.)

# Required in every mode: the development gateway key. In jwt mode it
# is not used for authentication but must be set.
GATEWAY_API_KEY=

# --- Authentication mode -------------------------------------------------
# devkey (default, local development only) | jwt (pilot/production shape)
ETHIO_AUTH_MODE=devkey

# --- Durable task store --------------------------------------------------
# memory (default) | pg | supabase. Durable modes REQUIRE
# ETHIO_AUTH_MODE=jwt and fail fast at startup without it.
ETHIO_TASK_STORE=memory
# ETHIO_PG_DSN=postgresql://user:pass@127.0.0.1:5432/ethio

# --- Supabase (server-side only; NEVER in the Flutter app) ----------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_KEY=
# Legacy HS256 projects only; ES256 projects are verified via JWKS
# fetched from SUPABASE_URL and need no secret here.
# SUPABASE_JWT_SECRET=
# Optional inline JWKS (otherwise fetched + cached from SUPABASE_URL):
# ETHIO_JWT_JWKS_JSON=

# --- LLM (development) ----------------------------------------------------
# Groq is the default provider; Gemini only when explicitly selected.
# Keys belong in the Secure Vault / environment, never in this file.
ETHIO_LLM_PROVIDER=groq
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Browser origins allowed to call the gateway (Flutter WEB pilot only;
# native apps don't use CORS). Comma-separated, exact origins; unset =
# no CORS headers. "*" is refused by the gateway.
# ETHIO_CORS_ORIGINS=http://localhost:8080

# --- Limits (defaults shown) ----------------------------------------------
# ETHIO_RATE_LIMIT_TASKS=20
# ETHIO_RATE_LIMIT_WINDOW=3600
# ETHIO_MAX_CONCURRENT_JOBS=10
